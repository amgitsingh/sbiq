# =============================================================================
# QBCals — Environment Configuration
# Copy this file to backend/.env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# AI / LLM  (model-agnostic — swap provider by changing these three values)
# -----------------------------------------------------------------------------

# API key for the LLM provider (OpenAI, Anthropic, Mistral, etc.)
AI_API_KEY=

# Base URL of the OpenAI-compatible API endpoint
# OpenAI:    https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# Mistral:   https://api.mistral.ai/v1
AI_BASE_URL=https://api.openai.com/v1

# Chat/reasoning model used for enrichment normalization and match reasoning
AI_MODEL=gpt-4o

# Embedding model — must produce 1536-dimension vectors for pgvector schema
AI_EMBEDDING_MODEL=text-embedding-3-small

# Hard cap on tokens consumed per matching run (cost guardrail)
AI_MAX_TOKENS_PER_RUN=100000

# -----------------------------------------------------------------------------
# External Enrichment APIs
# -----------------------------------------------------------------------------

# Tavily Search API key (web search + news mode for company enrichment)
# Sign up at https://tavily.com
TAVILY_API_KEY=

# Crunchbase API key (employee count, funding stage, investors, HQ)
# Sign up at https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=

# -----------------------------------------------------------------------------
# Enrichment source toggles
# Plug individual sources in/out without code changes — e.g. keep Crunchbase
# off until a paid API key is purchased. A disabled source returns its empty
# value immediately (None/[]/{}) and is never called.
# -----------------------------------------------------------------------------

ENABLE_WEBSITE_SCRAPER=true
ENABLE_TAVILY_WEB_SEARCH=true
ENABLE_TAVILY_NEWS_SEARCH=true
# Off by default — no CRUNCHBASE_API_KEY yet. Flip to true once purchased.
ENABLE_CRUNCHBASE=false
ENABLE_LINKEDIN_SCRAPER=true
# LLM normalization's own web search (OpenAI Responses API hosted tool) — fills
# gaps the 5 sources above missed. OpenAI-specific: turn off if AI_BASE_URL
# points at a different provider.
ENABLE_LLM_WEB_SEARCH=true

# Reuse a recent enrichment (by email) across events instead of re-running the
# whole pipeline for a repeat participant.
ENABLE_ENRICHMENT_REUSE=true
ENRICHMENT_REUSE_MAX_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Supabase (production database + pgvector)
# -----------------------------------------------------------------------------

# Project URL from the Supabase dashboard → Settings → API
SUPABASE_URL=

# Service role key (not the anon key — needed for server-side writes)
SUPABASE_KEY=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Local PostgreSQL (development)
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/qbcals

# Supabase PostgreSQL (production) — swap this in for production:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis / Celery  (background job queues)
# -----------------------------------------------------------------------------

# Redis connection URL — used by both Celery broker and the enrichment cache
REDIS_URL=redis://localhost:6379/0

# Celery broker — must match REDIS_URL in most setups
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend — use a separate Redis DB index to avoid key collisions
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# Email (SMTP) — sends a match's email_draft to the recipient participant
# -----------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# The actual `From` address on every sent email — never a participant's own
# address (see app/services/email_sender.py for why). Participant A's name
# appears as the display name; A's real email is set as Reply-To.
SMTP_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Auth (JWT) — stateless bearer tokens, no refresh flow. Ported verbatim from
# IndMatchmaking's own Settings field names so its ported auth code needs no
# changes here.
# -----------------------------------------------------------------------------

# Signs/verifies access tokens — MUST be overridden with a real random secret
# in any real deployment. The default is a placeholder, not a real secret.
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (720 = 12 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# -----------------------------------------------------------------------------
# Per-user SMTP credential encryption (admin/registrations domains)
# -----------------------------------------------------------------------------

# Fernet key encrypting SmtpMaster.password_encrypted (each admin's own SMTP
# password, set via PUT /admin/smtp). Falls back to a key derived from
# JWT_SECRET_KEY if unset (fine for local dev) — set a real one via a proper
# Fernet key (e.g. `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`) for anything beyond local dev.
SMTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Microsoft Graph mail (alternate email-delivery path for admin/registration
# emails — tried before falling back to a UserMaster's own SmtpMaster row).
# Leave all three unset to skip this path entirely and always use SmtpMaster.
# -----------------------------------------------------------------------------

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TIMEOUT_SECONDS=20.0

# -----------------------------------------------------------------------------
# Registration / admin links
# -----------------------------------------------------------------------------

# Link included in activation emails — the frontend's login page.
# Production: https://app.sbiq.ai/login
MATCHMAKING_APPLICATION_URL=http://localhost:8024/login

# -----------------------------------------------------------------------------
# External system-to-system API (/external/*)
# -----------------------------------------------------------------------------

# Gates X-API-Key enforcement on /external/* — those routes stay open (no
# check) if this is unset, same "off means skip the check" convention as the
# enrichment source toggles above. Set a real key before exposing this beyond
# local dev — the payloads carry participant contact details.
EXTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated (not JSON) — e.g. https://admin.example.com,https://app.example.com
# "*" (the default) allows any origin, fine for local dev, not for production.
# Production: ALLOWED_CORS_ORIGINS=https://app.sbiq.ai
ALLOWED_CORS_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
